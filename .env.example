# Copy this file to .env and fill in the two URLs from the Neon console,
# under Postgres database > Data API.
#
# Both of these are public endpoints.  They are baked into the built site
# and are visible to anyone who opens it, which is fine.
#
# NEVER put a Postgres connection string, a database password, or a Neon
# management API key in this file or anywhere else in this repository.
# The browser does not need them and must not have them.

VITE_NEON_AUTH_URL=https://ep-example-12345678.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-example-12345678.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
